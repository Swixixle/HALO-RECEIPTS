{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo-receipts/receipt.schema.json",
  "title": "HALO Receipt (current signing model)",
  "type": "object",
  "additionalProperties": true,
  "required": ["content_hash", "subject"],
  "properties": {
    "schema_version": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "content_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value"],
      "properties": {
        "alg": { "type": "string", "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["byte_length"],
      "properties": {
        "byte_length": { "type": "integer", "minimum": 0 },
        "content_type": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"] }
      }
    },
    "issuer": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": ["string", "null"] },
        "key_id": { "type": ["string", "null"] }
      }
    }
  }
}

