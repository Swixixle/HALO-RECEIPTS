nano src/index.js
import { sealReceipt, verifyReceipt } from "./receipt.js";

function createReceipt({ action, intent, evidence = [], prevHash = null }) {
  return {
    id: `HALO-${Date.now()}`,
    timestamp: new Date().toISOString(),
    action,
    intent,
    evidence,
    prevHash,
  };
}

// Create + seal
const r1 = sealReceipt(
  createReceipt({
    action: "INITIALIZE_PROJECT",
    intent: "Prove HALO receipts can exist as tamper-evident executable artifacts",
    evidence: [{ repo: "Swixxle/HALO-RECEIPTS", demo: "node src/index.js" }],
  })
);

console.log("HALO RECEIPT (sealed)");
console.log(JSON.stringify(r1, null, 2));

const v1 = verifyReceipt(r1);
console.log("\nverify:", v1.ok);

// Tamper test (optional, but useful)
const tampered = {
  ...r1,
  intent: "I changed the intent after the fact",
};

const v2 = verifyReceipt(tampered);
console.log("\nHALO RECEIPT (tampered)");
console.log("verify:", v2.ok);

// HARD RULE: if any verify fails, exit non-zero (locks the win)
if (!v1.ok) process.exit(1);
