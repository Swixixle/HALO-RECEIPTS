import crypto from "crypto";
import crypto from "crypto";

export function sha256(str) {
  return crypto.createHash("sha256").update(str, "utf8").digest("hex");
}

// Canonical form must be deterministic (same input => same exact string)
export function canonicalizeReceipt(r) {
  // IMPORTANT: only include fields you want integrity-protected
  // (no "verified" field, ever)
  const canonicalObj = {
    id: r.id,
    timestamp: r.timestamp,
    action: r.action,
    intent: r.intent,
    evidence: r.evidence ?? [],
    prevHash: r.prevHash ?? null,
  };

  return JSON.stringify(canonicalObj);
}

export function sealReceipt(receipt) {
  const canonical = canonicalizeReceipt(receipt);
  const hash = sha256(canonical);

  return {
    ...receipt,
    integrity: {
      algo: "sha256",
      canonical,
      hash,
    },
  };
}

export function verifyReceipt(receipt) {
  if (!receipt?.integrity?.hash || !receipt?.integrity?.canonical) {
    return { ok: false, reason: "missing_integrity_fields" };
  }

  const recomputed = sha256(receipt.integrity.canonical);
  const ok = recomputed === receipt.integrity.hash;

  return {
    ok,
    expected: receipt.integrity.hash,
    got: recomputed,
  };
}nano src/receipt.js

