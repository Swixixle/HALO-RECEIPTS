# Database Configuration
# PostgreSQL connection string
# For Replit: Use the PostgreSQL database from the Replit sidebar
# Example: postgresql://username:password@hostname:5432/database
DATABASE_URL=postgresql://user:password@localhost:5432/halo_receipts

# API Authentication
# API key for authenticating private endpoints
# In development, "dev-test-key-12345" is automatically available
API_KEY=your-api-key-here

# Application Configuration
NODE_ENV=development
PORT=5000

# Transcript Display Mode
# Options: full, redacted, hidden
TRANSCRIPT_MODE=full

# Session Security
# Secret key for session hashing in security audit
# Generate a strong random string for production
SESSION_SECRET=your-session-secret-here

# GitHub Integration (Optional)
# Only needed if using GitHub connectors
# REPLIT_CONNECTORS_HOSTNAME=your-replit-hostname
# REPL_IDENTITY=your-repl-identity
# WEB_REPL_RENEWAL=your-web-repl-renewal
